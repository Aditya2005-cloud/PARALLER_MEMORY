    "## 📊 CELL 8 — Evaluate: New Model vs Old Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "evaluate-models",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sentence_transformers import SentenceTransformer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "import numpy as np\n",
    "\n",
    "# We use semantic similarity as a proxy metric for memory analysis quality\n",
    "# (since there's no fixed ground truth label)\n",
    "\n",
    "embed_model = SentenceTransformer('all-MiniLM-L6-v2')\n",
    "\n",
    "def evaluate_model_outputs(predictions: list, references: list) -> float:\n",
    "    \"\"\"\n",
    "    Computes average semantic similarity between predictions and references.\n",
    "    Score: 0.0 (bad) to 1.0 (perfect)\n",
    "    \"\"\"\n",
    "    pred_embs = embed_model.encode(predictions)\n",
    "    ref_embs  = embed_model.encode(references)\n",
    "    scores = [\n",
    "        cosine_similarity([p], [r])[0][0]\n",
    "        for p, r in zip(pred_embs, ref_embs)\n",
    "    ]\n",
    "    return float(np.mean(scores))\n",
    "\n",
    "\n",
    "def ab_test(old_outputs: list, new_outputs: list, references: list):\n",
    "    \"\"\"Compare old vs new model on same test cases.\"\"\"\n",
    "    old_score = evaluate_model_outputs(old_outputs, references)\n",
    "    new_score = evaluate_model_outputs(new_outputs, references)\n",
    "\n",
    "    print('\\n🧪 A/B TEST RESULTS')\n",
    "    print('=' * 35)\n",
    "    print(f'  Old model score: {old_score:.4f}')\n",
    "    print(f'  New model score: {new_score:.4f}')\n",
    "    delta = new_score - old_score\n",
    "    if delta > 0.01:\n",
    "        print(f'  ✅ New model is BETTER by {delta:.4f} → DEPLOY')\n",
    "        return 'deploy'\n",
    "    elif delta < -0.01:\n",
    "        print(f'  ❌ New model is WORSE by {abs(delta):.4f} → KEEP OLD')\n",
    "        return 'rollback'\n",
    "    else:\n",
    "        print(f'  ➡️  No significant difference → KEEP OLD (save compute)')\n",
    "        return 'no_change'\n",
    "\n",
    "\n",
    "# ─── Demo ───\n",
    "references   = ['You felt regret and loss over this choice.']\n",
    "old_outputs  = ['You felt uncertain about this decision.']\n",
    "new_outputs  = ['You experienced deep regret and a sense of loss.']\n",
    "\n",
    "decision = ab_test(old_outputs, new_outputs, references)"
   ]
  },
