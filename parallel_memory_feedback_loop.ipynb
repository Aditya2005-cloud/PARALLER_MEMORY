    "## 🗃️ CELL 3 — Feedback Database Setup (SQLite)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "setup-db",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sqlite3\n",
    "from datetime import datetime\n",
    "\n",
    "def init_db():\n",
    "    \"\"\"Create feedback tables if they don't exist.\"\"\"\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    c = conn.cursor()\n",
    "\n",
    "    # Main feedback table\n",
    "    c.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS feedback (\n",
    "            id           INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            timestamp    TEXT NOT NULL,\n",
    "            user_id      TEXT,\n",
    "            memory_id    TEXT,          -- which memory this feedback is about\n",
    "            input_text   TEXT NOT NULL,  -- what user submitted\n",
    "            ai_output    TEXT NOT NULL,  -- what the AI generated\n",
    "            rating       INTEGER,        -- 1=thumbs up, 0=thumbs down\n",
    "            correction   TEXT,           -- user's corrected version (if any)\n",
    "            confidence   REAL,           -- AI confidence score (0.0 to 1.0)\n",
    "            feedback_type TEXT,          -- 'emotion', 'timeline', 'drift', 'general'\n",
    "            used_in_training INTEGER DEFAULT 0  -- flag: already used for retraining?\n",
    "        )\n",
    "    ''')\n",
    "\n",
    "    # Exception log table (auto-logged when AI is uncertain)\n",
    "    c.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS exceptions (\n",
    "            id           INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            timestamp    TEXT NOT NULL,\n",
    "            memory_id    TEXT,\n",
    "            input_text   TEXT,\n",
    "            ai_output    TEXT,\n",
    "            confidence   REAL,\n",
    "            error_type   TEXT,   -- 'low_confidence', 'contradiction', 'hallucination'\n",
    "            resolved     INTEGER DEFAULT 0\n",
    "        )\n",
    "    ''')\n",
    "\n",
    "    # Retraining history\n",
    "    c.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS retrain_log (\n",
    "            id              INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            timestamp       TEXT NOT NULL,\n",
    "            trigger_reason  TEXT,    -- 'scheduled', 'threshold', 'manual'\n",
    "            samples_used    INTEGER,\n",
    "            old_accuracy    REAL,\n",
    "            new_accuracy    REAL,\n",
    "            model_deployed  INTEGER DEFAULT 0\n",
    "        )\n",
    "    ''')\n",
    "\n",
    "    conn.commit()\n",
    "    conn.close()\n",
    "    print('✅ Database initialized')\n",
    "\n",
    "init_db()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "section-3",
   "metadata": {},
   "source": [
    "## 📥 CELL 4 — Feedback Collection Functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "feedback-functions",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sqlite3\n",
    "import json\n",
    "from datetime import datetime\n",
    "\n",
    "# ─────────────────────────────────────────────\n",
    "# A) Log user feedback (called after every AI response)\n",
    "# ─────────────────────────────────────────────\n",
    "def log_feedback(\n",
    "    input_text: str,\n",
    "    ai_output: str,\n",
    "    rating: int,             # 1 = good, 0 = bad\n",
    "    correction: str = None,  # what the user says should have happened\n",
    "    confidence: float = 1.0,\n",
    "    feedback_type: str = 'general',\n",
    "    memory_id: str = None,\n",
    "    user_id: str = 'anonymous'\n",
    "):\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    conn.execute('''\n",
    "        INSERT INTO feedback\n",
    "        (timestamp, user_id, memory_id, input_text, ai_output,\n",
    "         rating, correction, confidence, feedback_type)\n",
    "        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n",
    "    ''', (\n",
    "        datetime.now().isoformat(),\n",
    "        user_id, memory_id, input_text, ai_output,\n",
    "        rating, correction, confidence, feedback_type\n",
    "    ))\n",
    "    conn.commit()\n",
    "    conn.close()\n",
    "    print(f'✅ Feedback logged | rating={rating} | type={feedback_type}')\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────\n",
    "# B) Auto-log exceptions (called by AI when confidence is low)\n",
    "# ─────────────────────────────────────────────\n",
    "def log_exception(\n",
    "    input_text: str,\n",
    "    ai_output: str,\n",
    "    confidence: float,\n",
    "    error_type: str = 'low_confidence',\n",
    "    memory_id: str = None\n",
    "):\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    conn.execute('''\n",
    "        INSERT INTO exceptions\n",
    "        (timestamp, memory_id, input_text, ai_output, confidence, error_type)\n",
    "        VALUES (?, ?, ?, ?, ?, ?)\n",
    "    ''', (\n",
    "        datetime.now().isoformat(),\n",
    "        memory_id, input_text, ai_output, confidence, error_type\n",
    "    ))\n",
    "    conn.commit()\n",
    "    conn.close()\n",
    "\n",
    "    # Also write to flat log file for quick inspection\n",
    "    with open(LOG_PATH, 'a') as f:\n",
    "        f.write(json.dumps({\n",
    "            'ts': datetime.now().isoformat(),\n",
    "            'type': error_type,\n",
    "            'confidence': confidence,\n",
    "            'input': input_text[:100]\n",
    "        }) + '\\n')\n",
    "\n",
    "    print(f'⚠️  Exception logged | type={error_type} | confidence={confidence:.2f}')\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────\n",
    "# C) Quick feedback stats dashboard\n",
    "# ─────────────────────────────────────────────\n",
    "def feedback_stats():\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    c = conn.cursor()\n",
    "\n",
    "    total      = c.execute('SELECT COUNT(*) FROM feedback').fetchone()[0]\n",
    "    positive   = c.execute('SELECT COUNT(*) FROM feedback WHERE rating=1').fetchone()[0]\n",
    "    negative   = c.execute('SELECT COUNT(*) FROM feedback WHERE rating=0').fetchone()[0]\n",
    "    with_corr  = c.execute('SELECT COUNT(*) FROM feedback WHERE correction IS NOT NULL').fetchone()[0]\n",
    "    unused     = c.execute('SELECT COUNT(*) FROM feedback WHERE used_in_training=0').fetchone()[0]\n",
    "    exceptions = c.execute('SELECT COUNT(*) FROM exceptions WHERE resolved=0').fetchone()[0]\n",
    "\n",
    "    conn.close()\n",
    "\n",
    "    print('=' * 40)\n",
    "    print('📊 FEEDBACK DASHBOARD')\n",
    "    print('=' * 40)\n",
    "    print(f'  Total feedback:      {total}')\n",
    "    print(f'  👍 Positive:         {positive}')\n",
    "    print(f'  👎 Negative:         {negative}')\n",
    "    print(f'  ✏️  With corrections: {with_corr}')\n",
    "    print(f'  🔄 Unused (for train): {unused}')\n",
    "    print(f'  ⚠️  Open exceptions:  {exceptions}')\n",
    "    if total > 0:\n",
    "        print(f'  ⭐ Satisfaction:     {positive/total*100:.1f}%')\n",
    "    print('=' * 40)\n",
    "\n",
    "\n",
    "# ─────────────── DEMO RUN ───────────────\n",
    "log_feedback(\n",
    "    input_text   = 'In 2022 I rejected a music scholarship.',\n",
    "    ai_output    = 'You felt uncertain about this decision.',\n",
    "    rating       = 0,\n",
    "    correction   = 'I felt forced, not uncertain.',\n",
    "    confidence   = 0.61,\n",
    "    feedback_type= 'emotion'\n",
    ")\n",
    "\n",
    "log_exception(\n",
    "    input_text = 'I moved abroad and started a company.',\n",
    "    ai_output  = 'You may have felt nostalgic.',\n",
    "    confidence = 0.42,\n",
    "    error_type = 'low_confidence'\n",
    ")\n",
    "\n",
    "feedback_stats()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "section-4",
   "metadata": {},
   "source": [
    "## 🔍 CELL 5 — Retraining Trigger Logic"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "retrain-trigger",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "\n",
    "# ── Config ────────────────────────────────────\n",
    "RETRAIN_CONFIG = {\n",
    "    'min_new_samples':     20,    # retrain after N new negative feedbacks\n",
    "    'neg_ratio_threshold': 0.30,  # retrain if >30% responses are bad\n",
    "    'low_conf_threshold':  10,    # retrain after N unresolved exceptions\n",
    "    'schedule_days':       7,     # also retrain every 7 days regardless\n",
    "}\n",
    "\n",
    "def should_retrain() -> dict:\n",
    "    \"\"\"\n",
    "    Checks all trigger conditions.\n",
    "    Returns a dict: {'trigger': bool, 'reason': str, 'details': dict}\n",
    "    \"\"\"\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    c = conn.cursor()\n",
    "\n",
    "    # Count unused negative feedback with corrections\n",
    "    new_neg = c.execute('''\n",
    "        SELECT COUNT(*) FROM feedback\n",
    "        WHERE rating=0 AND used_in_training=0\n",
    "    ''').fetchone()[0]\n",
    "\n",
    "    # Calculate negative ratio over last 50 responses\n",
    "    last_50 = c.execute('''\n",
    "        SELECT rating FROM feedback\n",
    "        ORDER BY id DESC LIMIT 50\n",
    "    ''').fetchall()\n",
    "    neg_ratio = sum(1 for r in last_50 if r[0] == 0) / max(len(last_50), 1)\n",
    "\n",
    "    # Count unresolved exceptions\n",
    "    open_exc = c.execute(\n",
    "        'SELECT COUNT(*) FROM exceptions WHERE resolved=0'\n",
    "    ).fetchone()[0]\n",
    "\n",
    "    # Days since last retraining\n",
    "    last_train = c.execute(\n",
    "        'SELECT timestamp FROM retrain_log ORDER BY id DESC LIMIT 1'\n",
    "    ).fetchone()\n",
    "\n",
    "    days_since = 999  # default if never trained\n",
    "    if last_train:\n",
    "        from datetime import datetime\n",
    "        last_dt = datetime.fromisoformat(last_train[0])\n",
    "        days_since = (datetime.now() - last_dt).days\n",
    "\n",
    "    conn.close()\n",
    "\n",
    "    details = {\n",
    "        'new_negative_samples': new_neg,\n",
    "        'negative_ratio_last50': round(neg_ratio, 3),\n",
    "        'open_exceptions': open_exc,\n",
    "        'days_since_last_train': days_since\n",
    "    }\n",
    "\n",
    "    # Check each trigger\n",
    "    if new_neg >= RETRAIN_CONFIG['min_new_samples']:\n",
    "        return {'trigger': True,  'reason': 'threshold_samples', 'details': details}\n",
    "    if neg_ratio >= RETRAIN_CONFIG['neg_ratio_threshold']:\n",
    "        return {'trigger': True,  'reason': 'high_neg_ratio',    'details': details}\n",
    "    if open_exc >= RETRAIN_CONFIG['low_conf_threshold']:\n",
    "        return {'trigger': True,  'reason': 'too_many_exceptions','details': details}\n",
    "    if days_since >= RETRAIN_CONFIG['schedule_days']:\n",
    "        return {'trigger': True,  'reason': 'scheduled',          'details': details}\n",
    "\n",
    "    return {'trigger': False, 'reason': 'no_trigger', 'details': details}\n",
    "\n",
    "\n",
    "# ─────────── Check now ───────────\n",
    "result = should_retrain()\n",
    "print('🔍 Retraining Check:')\n",
    "print(f\"  Should retrain: {result['trigger']}\")\n",
    "print(f\"  Reason:         {result['reason']}\")\n",
    "print(f\"  Details:        {result['details']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "section-5",
   "metadata": {},
   "source": [
    "## 🏋️ CELL 6 — Build Training Dataset from Feedback"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "build-dataset",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "from datasets import Dataset\n",
    "\n",
    "def build_training_dataset(min_samples: int = 10):\n",
    "    \"\"\"\n",
    "    Pulls unused feedback from DB and builds a HuggingFace Dataset.\n",
    "    Uses corrections where available, otherwise uses original AI output\n",
    "    (for positive samples).\n",
    "    \"\"\"\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "\n",
    "    df = pd.read_sql_query('''\n",
    "        SELECT id, input_text, ai_output, correction, rating, feedback_type\n",
    "        FROM feedback\n",
    "        WHERE used_in_training = 0\n",
    "        ORDER BY id ASC\n",
    "    ''', conn)\n",
    "    conn.close()\n",
    "\n",
    "    if len(df) < min_samples:\n",
    "        print(f'⚠️  Only {len(df)} samples — need at least {min_samples}. Skipping.')\n",
    "        return None\n",
    "\n",
    "    # Build instruction-response pairs\n",
    "    records = []\n",
    "    for _, row in df.iterrows():\n",
    "        # Use user's correction if provided, else use AI output (positive sample)\n",
    "        target = row['correction'] if row['correction'] else row['ai_output']\n",
    "\n",
    "        # Skip negative feedback with no correction (unusable)\n",
    "        if row['rating'] == 0 and not row['correction']:\n",
    "            continue\n",
    "\n",
    "        records.append({\n",
    "            'feedback_id': row['id'],\n",
    "            'instruction': (\n",
    "                f\"You are a memory analysis AI. Analyze the following memory \"\n",
    "                f\"and provide emotional and psychological insights.\\n\\n\"\n",
    "                f\"Memory: {row['input_text']}\"\n",
    "            ),\n",
    "            'output': target,\n",
    "            'feedback_type': row['feedback_type']\n",
    "        })\n",
    "\n",
    "    if not records:\n",
    "        print('⚠️  No usable training samples found.')\n",
    "        return None\n",
    "\n",
    "    dataset = Dataset.from_list(records)\n",
    "\n",
    "    # Format as instruction-following text for fine-tuning\n",
    "    def format_sample(example):\n",
    "        example['text'] = (\n",
    "            f\"### Instruction:\\n{example['instruction']}\\n\\n\"\n",
    "            f\"### Response:\\n{example['output']}\"\n",
    "        )\n",
    "        return example\n",
    "\n",
    "    dataset = dataset.map(format_sample)\n",
    "    print(f'✅ Training dataset built: {len(dataset)} samples')\n",
    "    print(dataset[0]['text'][:300], '...')\n",
    "    return dataset\n",
    "\n",
    "\n",
    "train_dataset = build_training_dataset(min_samples=1)  # set to 1 for demo"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "section-6",
   "metadata": {},
   "source": [
    "## 🤖 CELL 7 — LoRA Fine-Tuning (Memory-Efficient, runs on T4 GPU)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "lora-finetune",
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from transformers import (\n",
    "    AutoTokenizer, AutoModelForCausalLM,\n",
    "    TrainingArguments, Trainer, DataCollatorForLanguageModeling\n",
    ")\n",
    "from peft import LoraConfig, get_peft_model, TaskType\n",
    "import sqlite3\n",
    "from datetime import datetime\n",
    "\n",
    "# ─── Config — change model_name for your actual LLM ───\n",
    "BASE_MODEL   = 'TinyLlama/TinyLlama-1.1B-Chat-v1.0'  # swap for Llama-3 / Phi-3\n",
    "MAX_LENGTH   = 512\n",
    "LORA_R       = 8      # LoRA rank (lower = faster, less capacity)\n",
    "LORA_ALPHA   = 16\n",
    "LORA_DROPOUT = 0.1\n",
    "TRAIN_EPOCHS = 3\n",
    "BATCH_SIZE   = 4\n",
    "\n",
    "\n",
    "def run_lora_finetuning(dataset, trigger_reason='manual'):\n",
    "    if dataset is None or len(dataset) == 0:\n",
    "        print('❌ No dataset provided.')\n",
    "        return\n",
    "\n",
    "    print(f'🚀 Starting LoRA fine-tuning on {len(dataset)} samples...')\n",
    "\n",
    "    # 1. Load tokenizer + base model (4-bit quantized to fit Colab T4)\n",
    "    tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL)\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "    model = AutoModelForCausalLM.from_pretrained(\n",
    "        BASE_MODEL,\n",
    "        load_in_4bit=True,          # 4-bit quantization (fits T4)\n",
    "        torch_dtype=torch.float16,\n",
    "        device_map='auto'\n",
    "    )\n",
    "\n",
    "    # 2. Apply LoRA adapters (only trains ~1% of params)\n",
    "    lora_config = LoraConfig(\n",
    "        r=LORA_R,\n",
    "        lora_alpha=LORA_ALPHA,\n",
    "        target_modules=['q_proj', 'v_proj'],  # attention layers\n",
    "        lora_dropout=LORA_DROPOUT,\n",
    "        bias='none',\n",
    "        task_type=TaskType.CAUSAL_LM\n",
    "    )\n",
    "    model = get_peft_model(model, lora_config)\n",
    "    model.print_trainable_parameters()\n",
    "\n",
    "    # 3. Tokenize dataset\n",
    "    def tokenize(example):\n",
    "        return tokenizer(\n",
    "            example['text'],\n",
    "            truncation=True,\n",
    "            max_length=MAX_LENGTH,\n",
    "            padding='max_length'\n",
    "        )\n",
    "\n",
    "    tokenized = dataset.map(tokenize, batched=True)\n",
    "    tokenized = tokenized.remove_columns(\n",
    "        [c for c in tokenized.column_names if c not in ['input_ids', 'attention_mask']]\n",
    "    )\n",
    "\n",
    "    # 4. Training arguments\n",
    "    training_args = TrainingArguments(\n",
    "        output_dir=f'{PROJECT_DIR}/checkpoints',\n",
    "        num_train_epochs=TRAIN_EPOCHS,\n",
    "        per_device_train_batch_size=BATCH_SIZE,\n",
    "        gradient_accumulation_steps=4,\n",
    "        warmup_steps=10,\n",
    "        learning_rate=2e-4,\n",
    "        fp16=True,\n",
    "        logging_steps=5,\n",
    "        save_strategy='epoch',\n",
    "        report_to='none',      # change to 'wandb' if you want monitoring\n",
    "        optim='paged_adamw_8bit'\n",
    "    )\n",
    "\n",
    "    # 5. Train\n",
    "    trainer = Trainer(\n",
    "        model=model,\n",
    "        args=training_args,\n",
    "        train_dataset=tokenized,\n",
    "        data_collator=DataCollatorForLanguageModeling(tokenizer, mlm=False)\n",
    "    )\n",
    "\n",
    "    trainer.train()\n",
    "\n",
    "    # 6. Save new model\n",
    "    model.save_pretrained(MODEL_PATH)\n",
    "    tokenizer.save_pretrained(MODEL_PATH)\n",
    "    print(f'✅ Model saved to {MODEL_PATH}')\n",
    "\n",
    "    # 7. Mark feedback as used in DB\n",
    "    ids = [str(ex['feedback_id']) for ex in dataset]\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    conn.execute(\n",
    "        f'UPDATE feedback SET used_in_training=1 WHERE id IN ({\",\".join(ids)})'\n",
    "    )\n",
    "\n",
